---
import { XMLParser } from "fast-xml-parser";

const CHANNEL_ID = "UCoTBmnTZ5XwJY3Awkjjz_ag";
const RSS_URL = `https://www.youtube.com/feeds/videos.xml?channel_id=${CHANNEL_ID}`;
const MAX_VIDEOS = 6;

interface Video {
  id: string;
  title: string;
  views: number;
  published: string;
}

let videos: Video[] = [];

try {
  const res = await fetch(RSS_URL);
  const xml = await res.text();
  const parser = new XMLParser({
    ignoreAttributes: false,
    attributeNamePrefix: "@_",
  });
  const feed = parser.parse(xml);

  const entries = Array.isArray(feed.feed.entry)
    ? feed.feed.entry
    : feed.feed.entry
      ? [feed.feed.entry]
      : [];

  interface RssEntry {
    "yt:videoId": string;
    title: string;
    published: string;
    "media:group"?: {
      "media:title"?: string;
      "media:community"?: {
        "media:statistics"?: { "@_views"?: string };
      };
    };
  }

  videos = (entries as RssEntry[])
    .map((entry) => ({
      id: entry["yt:videoId"],
      title: entry["media:group"]?.["media:title"] ?? entry.title,
      views: Number(
        entry["media:group"]?.["media:community"]?.["media:statistics"]?.[
          "@_views"
        ] ?? 0
      ),
      published: entry.published,
    }))
    .sort((a, b) => b.views - a.views)
    .slice(0, MAX_VIDEOS);
} catch {
  // Fallback to known videos when RSS fetch fails (e.g. in CI)
  videos = [
    { id: "bz73HnT5tf4", title: "Live at HMVP Okachimachi Studio / 4-17-2024", views: 1791, published: "2024-04-17" },
    { id: "-ULhYmaRh6A", title: "Live at HMVP Okachimachi Studio / 5-20-2026", views: 1024, published: "2026-05-20" },
    { id: "CE-E8Lvcjmg", title: "Live at HMVP Okachimachi Studio / 6-18-2025 1st", views: 955, published: "2025-06-18" },
    { id: "_cR5PDa9iTw", title: "Live at HMVP Okachimachi Studio / 6-18-2025 2nd", views: 815, published: "2025-06-18" },
    { id: "NHt68rQ1SlU", title: "Live at HMVP Okachimachi Studio / 3-20-2024", views: 741, published: "2024-03-20" },
    { id: "LuItGeSY65I", title: "Live at HMVP Okachimachi Studio / 3-27-2025 1st", views: 491, published: "2025-03-27" },
  ];
}

const channelUrl = `https://www.youtube.com/channel/${CHANNEL_ID}`;
---

{
  videos.length > 0 && (
    <>
      <div class="yt-grid">
        {videos.map((v) => (
          <div class="yt-item">
            <div class="yt-wrapper">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                title={v.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
            <p class="yt-title">{v.title}</p>
            <p class="yt-views">
              {v.views.toLocaleString("ja-JP")} 回視聴
            </p>
          </div>
        ))}
      </div>
      <p class="yt-more">
        <a href={channelUrl} target="_blank" rel="noopener noreferrer">
          YouTubeチャンネルをもっと見る &rarr;
        </a>
      </p>
    </>
  )
}

<style>
  .yt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.2rem;
  }

  .yt-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .yt-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .yt-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .yt-title {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .yt-views {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .yt-more {
    margin-top: 1.5rem;
    text-align: center;
  }

  .yt-more a {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .yt-more a:hover {
    color: var(--color-navy);
  }
</style>
